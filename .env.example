# EduPulse Platform - environment template
# Copy to .env for local development. Never commit .env or real credentials.

SERVER_PORT=8080

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edupulse
DB_USER=edupulse
# Set this to the password configured for your local MySQL user.
DB_PASSWORD=

# Authentication: generate a unique secret of at least 32 random bytes.
# Example (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# AI providers (leave unused providers blank)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Email; dry-run avoids sending real messages during local development.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@edupulse.local
MAIL_DRY_RUN=true
MAIL_ALLOW_DEMO=false

# Machine Learning service (Dockerfile exposes port 8001)
ML_SERVICE_URL=http://localhost:8001
ML_ALLOWED_ORIGINS=http://localhost:5173

# Frontend origin allowed by the Spring backend
CLIENT_URL=http://localhost:5173
