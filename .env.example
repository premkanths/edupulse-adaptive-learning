# ===================================================================
# EduPulse Platform - Environment Variables Template
# Copy this file to .env and customize for your local setup
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edupulse
DB_USER=edupulse
DB_PASSWORD=edupulse

# JWT Authentication
# Secret must be at least 256 bits (32+ characters)
JWT_SECRET=EduPulseSuperSecretKeyForJwtTokenGeneration2026SecureKeyMustBeLongEnough
JWT_EXPIRATION_MS=86400000

# AI Provider Configurations (Priority: Gemini -> Groq -> Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Email SMTP Settings (JavaMailSender)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@edupulse.local
MAIL_DRY_RUN=true

# External Profile APIs
GITHUB_TOKEN=

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Client Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173
